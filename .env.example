# Runtime
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Database
DATABASE_URL=postgres://studylog:studylog@localhost:5432/studylog
DATABASE_URL_UNPOOLED=postgres://studylog:studylog@localhost:5432/studylog
POSTGRES_USER=studylog
POSTGRES_PASSWORD=studylog
POSTGRES_DB=studylog
POSTGRES_PORT=5432

# Auth
JWT_ACCESS_SECRET=dev-only-secret-change-me-at-least-32-chars
ACCESS_TOKEN_TTL=15
REFRESH_TOKEN_TTL_DAYS=30
# Exact origins allowed to send mutable requests, comma separated (no wildcards).
APP_ORIGIN=http://127.0.0.1:5173
# Replay of a just-rotated refresh token inside this window is a multi-tab race.
REFRESH_REUSE_GRACE_SECONDS=10
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_MINUTES=15

# Observability (optional in Phase 0)
SENTRY_DSN=
VITE_SENTRY_DSN=

# Optional services (later phases)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RESEND_API_KEY=
VITE_API_BASE_URL=
